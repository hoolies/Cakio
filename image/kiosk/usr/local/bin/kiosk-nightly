#!/usr/bin/env sh
# kiosk-nightly - the daily restart of the camera kiosk, run by cron as root.
#
# A reboot every day gives the unit a clean start (fresh X server, fresh
# players, memory back to zero) and applies anything staged on the disk for
# the next boot. The wall is back in about a minute.

set -eu

export LC_ALL=C
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
hash -r

readonly PROGNAME=kiosk-nightly

usage() {
    printf '%s\n' "Usage: $PROGNAME [OPTION]...
Restart this camera kiosk; run by cron at the time set with kiosk-apply.

  -h, --help    display this help and exit"
}

case ${1:-} in
    -h | --help)
        usage
        exit 0
        ;;
    '') ;;
    *)
        printf '%s: unrecognized option %s\n' "$PROGNAME" "'$1'" >&2
        printf "Try '%s --help' for more information.\n" "$PROGNAME" >&2
        exit 2
        ;;
esac

[ "$(id -u)" -eq 0 ] || {
    printf '%s: must run as root\n' "$PROGNAME" >&2
    exit 1
}

if ! grep -q ' /media/cakio ' /proc/mounts; then
    mount /media/cakio 2>/dev/null || true
fi
if [ -f /media/cakio/.update/READY ]; then
    logger -t "$PROGNAME" "applying staged update $(cat /media/cakio/.update/READY)"
    if kiosk-apply apply-update; then
        logger -t "$PROGNAME" 'staged update installed'
    else
        logger -t "$PROGNAME" 'staged update failed; rebooting the current release'
    fi
fi
logger -t "$PROGNAME" "daily reboot ($(uptime))"
sync
sleep 2
exec reboot

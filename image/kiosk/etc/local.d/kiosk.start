#!/bin/sh
# Boot-time setup for the camera kiosk (runs as root from the local service).

# Processes of other users are hidden; the camera URL is on the player's command line.
mount -o remount,hidepid=2 /proc 2>/dev/null

# Logs the kiosk user can write and the administrator can read.
mkdir -p /var/log/kiosk
chown cakio:cakio /var/log/kiosk
chmod 755 /var/log/kiosk

# Home directories, in case the saved configuration lacks them.
mkdir -p /home/cakio /home/kioskadm
chown cakio:cakio /home/cakio
chown kioskadm:kioskadm /home/kioskadm
chmod 700 /home/cakio /home/kioskadm

# Compressed swap in RAM. The whole system lives in memory and the unit has
# no disk swap, so when nine players get large the choice is between the
# kernel killing one of them and squeezing idle pages (the unused half of
# the root filesystem, player buffers) into zram at about a third of their
# size. Sized at half the memory; it costs nothing while unused.
if modprobe zram 2>/dev/null && [ -e /sys/block/zram0/disksize ]; then
    mem_kb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
    printf 'zstd\n' >/sys/block/zram0/comp_algorithm 2>/dev/null ||
        printf 'lz4\n' >/sys/block/zram0/comp_algorithm 2>/dev/null || true
    if printf '%sK\n' "$((mem_kb / 2))" >/sys/block/zram0/disksize 2>/dev/null &&
        mkswap /dev/zram0 >/dev/null 2>&1; then
        swapon -p 100 /dev/zram0 2>/dev/null || logger -t kiosk 'zram swap could not be enabled'
    fi
else
    logger -t kiosk 'zram module not available; running without swap'
fi

# The new kernel leaves a flag so the next boot can fall back. Reaching
# here means this kernel started; a boot of the previous kernel does not.
if ! /usr/local/bin/kiosk-apply confirm-boot; then
    logger -t kiosk 'this kernel started, but the boot menu flag could not be cleared'
fi

# Keep every CPU at its highest speed. A powersave clock adds a delay to the
# first frames after a quiet moment, which shows up as late video.
set_cpu_governor() {
    _sg_n=0
    for _sg_gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$_sg_gov" ] || continue
        if printf 'performance\n' >"$_sg_gov" 2>/dev/null; then
            _sg_n=$((_sg_n + 1))
        fi
    done
    if [ "$_sg_n" -eq 0 ]; then
        logger -t kiosk 'CPU frequency governor left unchanged'
    fi
}

set_cpu_governor

exit 0
